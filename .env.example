# Supabase (EPIC-26) — create a project at https://supabase.com and copy Project URL + anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Server-side / scripts only (never expose to the browser). Used by `npm run db:migrate` and `npm run puzzles:import-db`.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional — EPIC-33 analytics (Plausible). Domain as registered in Plausible (e.g. example.com).
VITE_PLAUSIBLE_DOMAIN=


# Optional — where client error reports (uncaught errors + React crashes) are POSTed as JSON.
# Leave empty to use the project's own Supabase (rpc report_client_error). No user ids / emails are sent.
VITE_ERROR_REPORT_URL=
